server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    # The API. With MANDATE_UI_KEY empty (the default) nothing is added and people sign in;
    # the session cookie and the console's own headers pass through. With a key set, it is
    # added here, never sent to the browser, and whoever can reach this page acts with its
    # role: keep that on localhost. An empty value sends no header at all.
    location /v1/ {
        proxy_pass http://${MANDATE_API_UPSTREAM};
        proxy_set_header X-Mandate-Key "${MANDATE_UI_KEY}";
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }

    # Caching uses `expires`, not add_header: an add_header here would drop the security
    # headers above for this location.
    location /assets/ {
        expires 30d;
    }

    # A single-page app: unknown paths load the app, which routes them.
    location / {
        try_files $uri /index.html;
        expires -1;
    }
}
