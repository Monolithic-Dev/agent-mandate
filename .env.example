# Copy to .env and fill in. Never commit .env.

# Graph database. FALKORDB_PORT is both the host port Docker publishes and the port the
# app connects to; change it if 6379 is already in use on your machine.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_BROWSER_PORT=3000
FALKORDB_PASSWORD=

# REST admin key (at least 16 characters; the API refuses to start otherwise)
MANDATE_API_KEY=

# Extra REST keys with a role (viewer, operator, admin) and a tenant list, separated by ';':
#   id:secret:role:tenant1,tenant2   or   id:secret:role:*      (secrets 16+ characters)
MANDATE_API_KEYS=
# The key the web console adds to its API calls. In development (npm run dev) it defaults to
# MANDATE_API_KEY, so there is nothing to sign in to; set MANDATE_UI_AUTH=login to sign in
# instead. In docker-compose.prod.yml it defaults to empty: people sign in as users.
MANDATE_UI_KEY=
MANDATE_UI_AUTH=

# Console sign-in: session length, and whether the cookie needs HTTPS (browsers also accept
# it on http://localhost). Users are managed in the console or with python -m mandate.users.
MANDATE_SESSION_TTL_SECONDS=43200
MANDATE_SESSION_IDLE_SECONDS=7200
MANDATE_COOKIE_SECURE=true

# Webhooks: the console's public address (approval links in Slack and JSON messages), how
# often the notifier looks for held actions (0 turns it off), how long a messaged link lasts,
# and whether webhooks may reach private addresses (local testing only; never in production).
MANDATE_PUBLIC_URL=
MANDATE_NOTIFY_INTERVAL_SECONDS=3
MANDATE_NOTIFY_LINK_TTL_SECONDS=3600
MANDATE_WEBHOOK_ALLOW_PRIVATE=false

# Agent MCP token signing secrets, newest first, comma separated (16+ characters each).
# Empty means a secret derived from the admin key signs (never the admin key itself). To rotate: put the new secret first, keep the old one until
# its tokens have expired, then remove it.
MANDATE_TOKEN_SECRETS=
MANDATE_TOKEN_TTL_SECONDS=86400

# Live agents only. The authority engine never calls a model and the scored evaluation uses
# deterministic scripted agents, so none of this is needed to run the product.
# Provider: anthropic | groq | openai | openai-compatible (any OpenAI-style server: Ollama,
# vLLM, OpenRouter, Together; set MANDATE_LLM_BASE_URL).
MANDATE_LLM_PROVIDER=anthropic
MANDATE_MODEL=claude-sonnet-5-5          # the model when the provider is anthropic
MANDATE_LLM_MODEL=                       # the model for any other provider (default: a sensible one)
MANDATE_LLM_BASE_URL=
MANDATE_LLM_API_KEY=                     # for openai-compatible servers that need a key
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Operations
MANDATE_LOG_LEVEL=INFO
MANDATE_RATE_LIMIT_PER_MIN=600
# Where GET /v1/eval/latest reads evaluation results (one folder per run, holding metrics.json)
MANDATE_RESULTS_DIR=docs/results

# One-container deployment (deploy/free): the API serves the built console, and the start script
# seeds the demo tenant and creates this admin on each start.
MANDATE_STATIC_DIR=
MANDATE_ADMIN_EMAIL=
MANDATE_ADMIN_PASSWORD=
